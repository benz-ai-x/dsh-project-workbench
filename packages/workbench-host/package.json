{
  "name": "@benz-ai-x/dsh-project-workbench",
  "description": "Host authority and Remote contract for the DeepSeek Harness Project Workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./auth": {
      "types": "./lib/types/owner-auth-service.d.ts",
      "default": "./lib/owner-auth-service.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./recovery": {
      "types": "./lib/types/recovery.d.ts",
      "default": "./lib/recovery.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-workbench": "./lib/recover-cli.js"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/owner-auth-service.js",
    "lib/recovery.js",
    "lib/recover-cli.js",
    "lib/chunks/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "scripts": {
    "bundle": "tsdown --config tsdown.config.ts",
    "test": "vitest run --config vitest.config.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "argon2": "0.45.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-credentials": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-credentials-local": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-home-paths": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../../deepseek-harness-baseline/vendor/cordis",
    "@deepseek-ai/dsh-client-connection": "link:../../../deepseek-harness-baseline/packages/client/connection",
    "@deepseek-ai/dsh-credentials": "link:../../../deepseek-harness-baseline/packages/credentials/credentials",
    "@deepseek-ai/dsh-credentials-local": "link:../../../deepseek-harness-baseline/packages/credentials/credentials-local",
    "@deepseek-ai/dsh-home-paths": "link:../../../deepseek-harness-baseline/packages/util/home-paths",
    "@deepseek-ai/dsh-host-webserver": "link:../../../deepseek-harness-baseline/packages/host/webserver",
    "@deepseek-ai/dsh-typert-generator": "link:../../../deepseek-harness-baseline/packages/typert/generator",
    "@deepseek-ai/dsh-typert-protocol": "link:../../../deepseek-harness-baseline/packages/typert/protocol",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
