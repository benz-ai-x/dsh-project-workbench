{
  "name": "@benz-ai-x/dsh-project-workbench-client",
  "version": "0.1.0",
  "description": "Accessible browser status surface for the DeepSeek Harness Project Workbench plugin",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown --config tsdown.client.config.ts",
    "test": "vitest run tests",
    "watch": "tsdown --config tsdown.client.config.ts --watch"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@benz-ai-x/dsh-project-workbench": "0.1.0",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-api-remotes": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-connection": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-locale": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-alpha.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@benz-ai-x/dsh-project-workbench": "link:../workbench-host",
    "@testing-library/react": "^16.3.2",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "lightningcss": "^1.32.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
